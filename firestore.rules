rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // Default-Deny Global Catch-All
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Identity, Type & Validation Helpers
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return isVerifiedUser() && callerEmail() == 'mr1sardor0130@gmail.com';
    }

    function adminDocPath(emailLower) {
      return /databases/$(database)/documents/admins/$(emailLower);
    }

    function hasAdminRecord() {
      return isVerifiedUser() && exists(adminDocPath(callerEmail()));
    }

    function canAccessPanel() {
      return isSuperAdmin()
        || (hasAdminRecord() && get(adminDocPath(callerEmail())).data.canAccessPanel == true);
    }

    function canManageBookings() {
      return isSuperAdmin()
        || (hasAdminRecord()
            && get(adminDocPath(callerEmail())).data.canAccessPanel == true
            && get(adminDocPath(callerEmail())).data.canManageBookings == true);
    }

    function canManageAdmins() {
      return isSuperAdmin()
        || (hasAdminRecord()
            && get(adminDocPath(callerEmail())).data.canAccessPanel == true
            && get(adminDocPath(callerEmail())).data.canManageAdmins == true);
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPhoneDigits(val) {
      return val is string && val.size() >= 7 && val.size() <= 20 && val.matches('^[0-9]{7,20}$');
    }

    function isValidEmailKey(val) {
      return val is string
        && val.size() >= 5
        && val.size() <= 120
        && val.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function isValidHallId(val) {
      return val in ['oilaviy-zal', 'vip-xona', 'banket-zali'];
    }

    function isValidReservationStatus(val) {
      return val in ['new', 'confirmed', 'arrived', 'cancelled'];
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================
    function isValidReservationBase(data) {
      return data.keys().hasAll([
          'code',
          'name',
          'phone',
          'phoneNormalized',
          'hallId',
          'hallTitle',
          'date',
          'time',
          'guests',
          'notes',
          'status',
          'adminNote',
          'telegramTarget',
          'handledByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'code',
          'name',
          'phone',
          'phoneNormalized',
          'hallId',
          'hallTitle',
          'date',
          'time',
          'guests',
          'notes',
          'status',
          'adminNote',
          'telegramTarget',
          'handledByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.code is string && data.code.size() >= 4 && data.code.size() <= 20 && data.code.matches('^[A-Za-z0-9\\-]+$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30
        && isValidPhoneDigits(data.phoneNormalized)
        && isValidHallId(data.hallId)
        && data.hallTitle is string && data.hallTitle.size() >= 3 && data.hallTitle.size() <= 80
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.time is string && data.time.size() == 5 && data.time.matches('^\\d{2}:\\d{2}$')
        && data.guests is int && data.guests >= 1 && data.guests <= 250
        && data.notes is string && data.notes.size() <= 500
        && isValidReservationStatus(data.status)
        && data.adminNote is string && data.adminNote.size() <= 500
        && data.telegramTarget is string && data.telegramTarget.size() >= 2 && data.telegramTarget.size() <= 50
        && data.handledByEmail is string && data.handledByEmail.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReservationCreate(data) {
      return isValidReservationBase(data)
        && data.status == 'new'
        && data.adminNote == ''
        && data.handledByEmail == ''
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidReservationUpdate(data) {
      return isValidReservationBase(data)
        && data.createdAt == existing().createdAt
        && data.updatedAt == request.time
        && data.code == existing().code
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'adminNote',
          'handledByEmail',
          'hallId',
          'hallTitle',
          'date',
          'time',
          'guests',
          'notes',
          'updatedAt'
        ]);
    }

    function isValidAdminBase(data, adminEmail) {
      return data.keys().hasAll([
          'email',
          'displayName',
          'canAccessPanel',
          'canManageBookings',
          'canManageAdmins',
          'addedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'email',
          'displayName',
          'canAccessPanel',
          'canManageBookings',
          'canManageAdmins',
          'addedBy',
          'createdAt',
          'updatedAt'
        ])
        && isValidEmailKey(data.email)
        && data.email == adminEmail
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.canAccessPanel is bool
        && data.canManageBookings is bool
        && data.canManageAdmins is bool
        && data.addedBy is string && data.addedBy.size() >= 5 && data.addedBy.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomerBase(data, customerId) {
      return data.keys().hasAll([
          'phoneNormalized',
          'phoneDisplay',
          'name',
          'tags',
          'crmNote',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'phoneNormalized',
          'phoneDisplay',
          'name',
          'tags',
          'crmNote',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && isValidPhoneDigits(data.phoneNormalized)
        && data.phoneNormalized == customerId
        && data.phoneDisplay is string && data.phoneDisplay.size() >= 7 && data.phoneDisplay.size() <= 30
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.tags is list && data.tags.size() <= 10
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        && data.crmNote is string && data.crmNote.size() <= 500
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 5 && data.updatedByEmail.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Match Blocks
    // =========================================================================
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /reservations/{reservationId} {
      allow get: if isValidId(reservationId) && canAccessPanel();
      allow list: if canAccessPanel();
      allow create: if isValidId(reservationId) && isValidReservationCreate(incoming());
      allow update: if isValidId(reservationId)
        && canManageBookings()
        && isValidReservationUpdate(incoming());
      allow delete: if isValidId(reservationId) && canManageBookings();
    }

    match /admins/{adminEmail} {
      allow get: if isValidEmailKey(adminEmail)
        && isVerifiedUser()
        && (isSuperAdmin() || callerEmail() == adminEmail || canManageAdmins());
      allow list: if canManageAdmins();
      allow create: if isValidEmailKey(adminEmail)
        && canManageAdmins()
        && isValidAdminBase(incoming(), adminEmail)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidEmailKey(adminEmail)
        && canManageAdmins()
        && (adminEmail != 'mr1sardor0130@gmail.com' || isSuperAdmin())
        && isValidAdminBase(incoming(), adminEmail)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'canAccessPanel',
          'canManageBookings',
          'canManageAdmins',
          'updatedAt'
        ]);
      allow delete: if isValidEmailKey(adminEmail)
        && canManageAdmins()
        && adminEmail != 'mr1sardor0130@gmail.com';
    }

    match /customers/{customerId} {
      allow get: if isValidPhoneDigits(customerId) && canAccessPanel();
      allow list: if canAccessPanel();
      allow create: if isValidPhoneDigits(customerId)
        && canManageBookings()
        && isValidCustomerBase(incoming(), customerId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidPhoneDigits(customerId)
        && canManageBookings()
        && isValidCustomerBase(incoming(), customerId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'phoneDisplay',
          'name',
          'tags',
          'crmNote',
          'updatedByEmail',
          'updatedAt'
        ]);
      allow delete: if isValidPhoneDigits(customerId) && canManageBookings();
    }
  }
}
